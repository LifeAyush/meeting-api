# SQLite by default (see app/db/session.py)
DATABASE_URL=sqlite:///./meetings.db

# Whisper model size: tiny (default, fast CPU demo) or base/small/...
WHISPER_MODEL=tiny

# mock = deterministic summary without an API key (default)
# openai = call OpenAI (requires OPENAI_API_KEY)
SUMMARY_MODE=mock
OPENAI_API_KEY=
